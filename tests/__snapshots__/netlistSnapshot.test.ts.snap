exports[`the netlist each preset writes > gearmotorTrip: AC sweep 1`] = `
"Circuit Simulation
V_v1 N1 0 DC 6 AC 1
B_f1_m int_f1_m 0 V = 1 / (1 + exp(-(V(int_f1_h) - 0.02) / 0.00002))
B_f1_g int_f1_g 0 V = 20 * (1 - V(int_f1_m)) + 1e-9
B_f1 N1 N2 I = (V(N1, N2) * V(int_f1_g))
C_f1_h int_f1_h 0 1
R_f1_h int_f1_h 0 1e12
B_f1_h 0 int_f1_h I = time <= 0 ? 0 : ((V(int_f1_h) <= 0 && (V(N1, N2) * V(int_f1_g)) * (V(N1, N2) * V(int_f1_g)) < 0.25) ? 0 : (1 - V(int_f1_m)) * ((V(N1, N2) * V(int_f1_g)) * (V(N1, N2) * V(int_f1_g)) - 0.25) + V(int_f1_m) * 20)
B_h1_h1 N2 N8 I = V(N2, N8) * (5.555555555555555 * (1 / (1 + exp(-(V(N5, 0) - 1.5) / 0.05))) * (1 - (1 / (1 + exp(-(V(N6, 0) - 1.5) / 0.05)))) + 1e-9)
B_h1_l1 N8 0 I = V(N8, 0) * (5.555555555555555 * (1 / (1 + exp(-(V(N6, 0) - 1.5) / 0.05))) + 1e-9)
