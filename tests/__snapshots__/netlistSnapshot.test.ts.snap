R_mcu1_A1 NC_mcu1_A1 0 100MEG
R_mcu1_A0 NC_mcu1_A0 0 100MEG
B_d1_sw int_d1_sw 0 V = (1 / (1 + exp(-(V(N4, 0) - 1.5) / 0.05)))
C_d1_ms int_d1_ms 0 1
R_d1_ms int_d1_ms 0 1e12
B_d1_ms 0 int_d1_ms I = 1000000 * ((V(int_d1_th) - 0.0625 * sin(16 * V(int_d1_th))) + 0.39269908169872414 * (2 * (1 / (1 + exp(-(V(N5, 0) - 1.5) / 0.05))) - 1) - V(int_d1_ms)) * (V(int_d1_sw) < 0.999999 ? 1 - V(int_d1_sw) : 0)
C_d1_th int_d1_th 0 1
R_d1_th int_d1_th 0 1e12
B_d1_th 0 int_d1_th I = 1000000 * (V(int_d1_ms) - V(int_d1_th)) * (V(int_d1_sw) > 1e-6 ? V(int_d1_sw) : 0)
B_d1_ta int_d1_ta 0 V = 1 * (1 - (1 / (1 + exp(-(V(0, 0) - 1.5) / 0.05)))) * cos((V(int_d1_th) + 0.7853981633974483))
B_d1_ua int_d1_ua 0 V = 300 * (V(int_d1_ta) - I(V_d1_sa)) > V(N1, 0) ? V(N1, 0) : (300 * (V(int_d1_ta) - I(V_d1_sa)) < -V(N1, 0) ? -V(N1, 0) : 300 * (V(int_d1_ta) - I(V_d1_sa)))
B_d1_a1 int_d1_da 0 V = (V(N1, 0) + V(int_d1_ua)) / 2
V_d1_sa int_d1_da N7 DC 0
B_d1_a2 N8 0 V = (V(N1, 0) - V(int_d1_ua)) / 2
B_d1_tb int_d1_tb 0 V = 1 * (1 - (1 / (1 + exp(-(V(0, 0) - 1.5) / 0.05)))) * sin((V(int_d1_th) + 0.7853981633974483))
B_d1_ub int_d1_ub 0 V = 300 * (V(int_d1_tb) - I(V_d1_sb)) > V(N1, 0) ? V(N1, 0) : (300 * (V(int_d1_tb) - I(V_d1_sb)) < -V(N1, 0) ? -V(N1, 0) : 300 * (V(int_d1_tb) - I(V_d1_sb)))
B_d1_b1 int_d1_db 0 V = (V(N1, 0) + V(int_d1_ub)) / 2
V_d1_sb int_d1_db N9 DC 0
B_d1_b2 N10 0 V = (V(N1, 0) - V(int_d1_ub)) / 2
B_d1_sup N1 0 I = V(N1, 0) > 0.5 ? (V(int_d1_ua) * I(V_d1_sa) + V(int_d1_ub) * I(V_d1_sb)) / V(N1, 0) : 0
R_s1_p1 N7 int_s1_p1r 1.5
L_s1_p1 int_s1_p1r int_s1_p1l 0.0028
B_s1_e1 int_s1_p1l N8 V = (-0.23529411764705885 * sin(50 * V(int_s1_x))) * V(int_s1_w)
R_s1_p2 N9 int_s1_p2r 1.5
L_s1_p2 int_s1_p2r int_s1_p2l 0.0028
B_s1_e2 int_s1_p2l N10 V = (0.23529411764705885 * cos(50 * V(int_s1_x))) * V(int_s1_w)
C_s1_j int_s1_w 0 0.0000054
R_s1_b int_s1_w 0 5000
B_s1_t 0 int_s1_w I = (-0.23529411764705885 * sin(50 * V(int_s1_x))) * I(L_s1_p1) + (0.23529411764705885 * cos(50 * V(int_s1_x))) * I(L_s1_p2) + -(0.015 * sin(200 * V(int_s1_x)))
C_s1_x int_s1_x 0 1
R_s1_xl int_s1_x 0 1e12
B_s1_x 0 int_s1_x I = V(int_s1_w)
R_shunt_NC_mcu1_D2 NC_mcu1_D2 0 1G
R_shunt_NC_mcu1_D3 NC_mcu1_D3 0 1G
R_shunt_NC_mcu1_5V NC_mcu1_5V 0 1G
R_shunt_NC_mcu1_A1 NC_mcu1_A1 0 1G
R_shunt_NC_mcu1_A0 NC_mcu1_A0 0 1G
.save all
