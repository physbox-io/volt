B_mot1_e1 int_mot1_p1l NC_mot1_b V = (0.02) * V(int_mot1_w)
C_mot1_j int_mot1_w 0 0.000005
R_mot1_b int_mot1_w 0 1000000
B_mot1_t 0 int_mot1_w I = (0.02) * I(L_mot1_p1) + -(0.001)
R_stp1_p1 NC_stp1_a1 int_stp1_p1r 1.5
L_stp1_p1 int_stp1_p1r int_stp1_p1l 0.0028
B_stp1_e1 int_stp1_p1l NC_stp1_a2 V = (-0.23529411764705885 * sin(50 * V(int_stp1_x))) * V(int_stp1_w)
R_stp1_p2 NC_stp1_b1 int_stp1_p2r 1.5
L_stp1_p2 int_stp1_p2r int_stp1_p2l 0.0028
B_stp1_e2 int_stp1_p2l NC_stp1_b2 V = (0.23529411764705885 * cos(50 * V(int_stp1_x))) * V(int_stp1_w)
C_stp1_j int_stp1_w 0 0.0000054
R_stp1_b int_stp1_w 0 5000
B_stp1_t 0 int_stp1_w I = (-0.23529411764705885 * sin(50 * V(int_stp1_x))) * I(L_stp1_p1) + (0.23529411764705885 * cos(50 * V(int_stp1_x))) * I(L_stp1_p2) + -(0.015 * sin(200 * V(int_stp1_x)))
C_stp1_x int_stp1_x 0 1
R_stp1_xl int_stp1_x 0 1e12
B_stp1_x 0 int_stp1_x I = V(int_stp1_w)
