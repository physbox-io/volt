V_drv1_sa int_drv1_da NC_drv1_a1 DC 0
B_drv1_a2 NC_drv1_a2 NC_drv1_gnd V = (V(NC_drv1_vm, NC_drv1_gnd) - V(int_drv1_ua)) / 2
B_drv1_ub int_drv1_ub 0 V = 1000 * (1.2 * (1 - (1 / (1 + exp(-(V(NC_drv1_en, NC_drv1_gnd) - 1.5) / 0.05)))) * sin((V(int_drv1_th) + 0.7853981633974483)) - I(V_drv1_sb)) > V(NC_drv1_vm, NC_drv1_gnd) ? V(NC_drv1_vm, NC_drv1_gnd) : (1000 * (1.2 * (1 - (1 / (1 + exp(-(V(NC_drv1_en, NC_drv1_gnd) - 1.5) / 0.05)))) * sin((V(int_drv1_th) + 0.7853981633974483)) - I(V_drv1_sb)) < -V(NC_drv1_vm, NC_drv1_gnd) ? -V(NC_drv1_vm, NC_drv1_gnd) : 1000 * (1.2 * (1 - (1 / (1 + exp(-(V(NC_drv1_en, NC_drv1_gnd) - 1.5) / 0.05)))) * sin((V(int_drv1_th) + 0.7853981633974483)) - I(V_drv1_sb)))
B_drv1_b1 int_drv1_db NC_drv1_gnd V = (V(NC_drv1_vm, NC_drv1_gnd) + V(int_drv1_ub)) / 2
V_drv1_sb int_drv1_db NC_drv1_b1 DC 0
B_drv1_b2 NC_drv1_b2 NC_drv1_gnd V = (V(NC_drv1_vm, NC_drv1_gnd) - V(int_drv1_ub)) / 2
B_drv1_sup NC_drv1_vm NC_drv1_gnd I = V(NC_drv1_vm, NC_drv1_gnd) > 0.5 ? (V(int_drv1_ua) * I(V_drv1_sa) + V(int_drv1_ub) * I(V_drv1_sb)) / V(NC_drv1_vm, NC_drv1_gnd) : 0
B_hb1_h1 NC_hb1_vm NC_hb1_out1 I = V(NC_hb1_vm, NC_hb1_out1) * (5.555555555555555 * (1 / (1 + exp(-(V(NC_hb1_in1, NC_hb1_gnd) - 1.5) / 0.05))) * (1 - (1 / (1 + exp(-(V(NC_hb1_in2, NC_hb1_gnd) - 1.5) / 0.05)))) + 1e-9)
B_hb1_l1 NC_hb1_out1 NC_hb1_gnd I = V(NC_hb1_out1, NC_hb1_gnd) * (5.555555555555555 * (1 / (1 + exp(-(V(NC_hb1_in2, NC_hb1_gnd) - 1.5) / 0.05))) + 1e-9)
B_hb1_h2 NC_hb1_vm NC_hb1_out2 I = V(NC_hb1_vm, NC_hb1_out2) * (5.555555555555555 * (1 / (1 + exp(-(V(NC_hb1_in2, NC_hb1_gnd) - 1.5) / 0.05))) * (1 - (1 / (1 + exp(-(V(NC_hb1_in1, NC_hb1_gnd) - 1.5) / 0.05)))) + 1e-9)
B_hb1_l2 NC_hb1_out2 NC_hb1_gnd I = V(NC_hb1_out2, NC_hb1_gnd) * (5.555555555555555 * (1 / (1 + exp(-(V(NC_hb1_in1, NC_hb1_gnd) - 1.5) / 0.05))) + 1e-9)
D_hb1_h1 NC_hb1_out1 NC_hb1_vm HB_DIODE_hb1
D_hb1_l1 NC_hb1_gnd NC_hb1_out1 HB_DIODE_hb1
D_hb1_h2 NC_hb1_out2 NC_hb1_vm HB_DIODE_hb1
D_hb1_l2 NC_hb1_gnd NC_hb1_out2 HB_DIODE_hb1
.model HB_DIODE_hb1 D(IS=1e-12 RS=0.05 N=1)
B_fu1_m int_fu1_m 0 V = 1 / (1 + exp(-(V(int_fu1_h) - 0.5) / 0.0005))
B_fu1_g int_fu1_g 0 V = 20 * (1 - V(int_fu1_m)) + 1e-9
B_fu1 NC_fu1_in NC_fu1_out I = (V(NC_fu1_in, NC_fu1_out) * V(int_fu1_g))
C_fu1_h int_fu1_h 0 1
R_fu1_h int_fu1_h 0 1e12
B_fu1_h 0 int_fu1_h I = (V(int_fu1_h) <= 0 && (V(NC_fu1_in, NC_fu1_out) * V(int_fu1_g)) * (V(NC_fu1_in, NC_fu1_out) * V(int_fu1_g)) < 4) ? 0 : (1 - V(int_fu1_m)) * ((V(NC_fu1_in, NC_fu1_out) * V(int_fu1_g)) * (V(NC_fu1_in, NC_fu1_out) * V(int_fu1_g)) - 4) + V(int_fu1_m) * 500
V_ms1 NC_ms1_out NC_ms1_gnd DC 0.8
V_ms2 NC_ms2_out NC_ms2_gnd DC 3.3
R_mot2_p1 NC_mot2_a int_mot2_p1r 2
L_mot2_p1 int_mot2_p1r int_mot2_p1l 0.0005
B_mot2_e1 int_mot2_p1l NC_mot2_b V = (0.01) * V(int_mot2_w)
B_mot2_tq int_mot2_tq 0 V = (0.01) * I(L_mot2_p1) + -(0.000001) * V(int_mot2_w)
C_mot2_j int_mot2_w 0 0.000105
R_mot2_b int_mot2_w 0 1000000
B_mot2_t 0 int_mot2_w I = (0.01) * I(L_mot2_p1) + -0.01

* Idealized Op-Amp Macro Model (Legacy compatibility)
* Node order: IN+ IN- VCC VEE OUT
.SUBCKT IDEAL_OPAMP 1 2 3 4 5
* High input impedance
Rin 1 2 100MEG
* Voltage controlled voltage source for gain (Gain = 100k)
E1 6 0 1 2 100k
* Output clipping to power rails
B1 5 0 V=V(6) > V(3) ? V(3) : (V(6) < V(4) ? V(4) : V(6))
.ENDS IDEAL_OPAMP

* Parameterized Op-Amp Subcircuit for u1
* Node order: IN+ IN- VCC VEE OUT
.SUBCKT OPAMP_MODEL_u1 1 2 3 4 5
Rin 1 2 100MEG
E1 6 0 1 2 100000
B1 5 0 V=V(6) > V(3) ? V(3) : (V(6) < V(4) ? V(4) : V(6))
.ENDS OPAMP_MODEL_u1

* Idealized NE555 Timer Macro Model
* Node order: GND TRIG OUT RST CTRL THR DIS VCC
.SUBCKT NE555 1 2 3 4 5 6 7 8
* Voltage divider
R1 8 5 5k
R2 5 61 5k
R3 61 1 5k

* Smooth SR Latch Integrator
* Instead of G-source integrating to infinity, use standard switches to charge/discharge a capacitor
S_SET 8 state 61 2 SMOD_ON
S_RST state 1 6 5 SMOD_ON
C1 state 1 100p
* Add parallel resistor to guarantee DC convergence
R4 state 1 10G

* Output buffer
E_OUT 3 1 VOL={V(state)>2.5 ? V(8) : 0}

* Discharge
S_DIS 7 1 8 state SMOD_DIS

.MODEL SMOD_ON SW(VT=0 RON=1k ROFF=10G)
.MODEL SMOD_DIS SW(VT=2.5 RON=10 ROFF=10G)
.ENDS NE555

* Idealized Master-Slave D Flip-Flop
* Node order: D CLK Q QBAR
.SUBCKT DFF D CLK Q QBAR
B_CLK_BAR clk_bar 0 V = 5 - V(CLK)

* Master Latch: closed when clk_bar > 2.5
S_M D state_m clk_bar 0 SMOD_DFF
C_M state_m 0 10n
R_M state_m 0 1G

* Buffer master to slave to prevent charge sharing between C_M and C_S
B_state_m_buf state_m_buf 0 V = V(state_m) > 2.5 ? 5 : 0

* Slave Latch: closed when CLK > 2.5
S_S state_m_buf state_s CLK 0 SMOD_DFF
C_S state_s 0 10n
R_S state_s 0 1G

* Output Drivers
B_Q Q 0 V = V(state_s) > 2.5 ? 5 : 0
B_QBAR QBAR 0 V = V(state_s) > 2.5 ? 0 : 5

.MODEL SMOD_DFF SW(VT=2.5 VH=0.2 RON=1k ROFF=1G)
.ENDS DFF
V_rail_N4 N4 0 DC 5
